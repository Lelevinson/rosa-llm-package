LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# Empty selects the first visible model in the signed-in account's ordered catalog.
OPENAI_MODEL=
# Credentials must be outside this project. Empty uses ~/.config/rosa-llm.
ROSA_LLM_AUTH_DIR=
ROSA_LLM_PROFILE=default
ROSA_LLM_TIMEOUT=120
# Enable for controlled runs; requires OPENAI_MODEL when using OpenAI.
ROSA_LLM_REQUIRE_EXPLICIT_MODEL=false
